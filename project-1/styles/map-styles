#map {
    position: absolute;
    top: 6%;
    bottom: 0;
    width: 100%;
    height: 94%;
}

.earthquake {
    background-image: url('../images/qt_marker_center.png');
    background-size: cover;
    width: 30px;
    height: 30px;
    cursor: pointer;
}

/* Search Form */
#search-list {
    position: relative;
    width: 440px;
}
#search-list .box {
    padding: 0 0 1.25rem;
}
#search-options {
    padding: 1.25rem 1.25rem 0 1.25rem;
}
#search-options .title {
    margin-bottom: 1rem;
}
.form-row {
    display: flex;
    flex-direction: row;
    margin: 0 auto;
    align-items: center;
}
form {
    display: flex;
    flex-direction: column;
    margin-right: 1rem;
}
.select select {
    font-family: 'Outfit', sans-serif;
}
hr {
    background-color: rgb(119, 119, 119);
    margin-bottom: .5rem;
}
.collapse {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    bottom: 20px;
    left: 185px;
    width: 30px;
    height: 20px;
    background-color: white;
    z-index: 1;
    outline: solid 2px grey;
    border-radius: 3px;
    cursor: pointer;
}

#quake-list {
    height: 40%;
    overflow-y: auto;
    overflow-x: hidden;
}